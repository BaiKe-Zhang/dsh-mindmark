{
  "name": "dsh-mindmark",
  "version": "0.3.0",
  "private": true,
  "description": "Show the model your mind: mark up an answer like in Word (highlight / underline / strike / comment / rewrite) and your markup reaches DeepSeek Harness as context on the next turn.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "LICENSE",
    "docs/demo.gif",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "annotation",
    "markup",
    "feedback",
    "human-in-the-loop",
    "intent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaiKe-Zhang/dsh-mindmark.git"
  },
  "homepage": "https://github.com/BaiKe-Zhang/dsh-mindmark#readme",
  "bugs": {
    "url": "https://github.com/BaiKe-Zhang/dsh-mindmark/issues"
  },
  "author": "BaiKe-Zhang",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  }
}
